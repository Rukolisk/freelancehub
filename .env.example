# =========================================
# FreelanceHub — Variables d'environnement
# =========================================

# PostgreSQL
DATABASE_URL="postgresql://freelancehub:secret@localhost:5432/freelancehub"

# Optionnel — Docker Compose
POSTGRES_USER=freelancehub
POSTGRES_PASSWORD=secret
POSTGRES_DB=freelancehub

# Serveur
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173
TRUSTED_ORIGIN=http://localhost:5173